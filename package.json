{
  "name": "libalstal",
  "version": "1.0.0",
  "private": true,
  "description": "LIBALSTAL — site vitrine FR/EN/AR (générateur statique sans dépendance + serveur Node pour les demandes de devis)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
